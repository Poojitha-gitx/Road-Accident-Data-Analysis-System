# Database Configuration
# Supported DB_TYPE: mysql (recommended for MySQL server / TiDB Cloud) or sqlite (fallback)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=accident_analysis_db

# Optional Cloud Database TLS / SSL (Auto-enabled when connecting to TiDB Cloud or port 4000)
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem  # Optional, defaults to certifi verified root CA bundle

# Flask Application Settings
SECRET_KEY=your_flask_secret_key_here_change_for_production
FLASK_DEBUG=False
PORT=5000
