# Database Configuration
# Supported DB_TYPE: mysql (recommended for MySQL server / TiDB Cloud) or sqlite (fallback)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=accident_analysis_db

# Optional Cloud Database TLS / SSL (Auto-enabled when connecting to TiDB Cloud or port 4000)
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem  # Optional, defaults to certifi verified root CA bundle

# Initial Administrator Account (Automatically bootstrapped on startup if not present)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password

# Gmail SMTP Configuration for 6-Digit Email OTP Verification
# Note: Use a Gmail App Password (generated in Google Account Security -> 2-Step Verification), NOT your normal Gmail password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Flask Application Settings
SECRET_KEY=road_accident_mini_project_secret_key_2026_change_in_production
FLASK_DEBUG=False
PORT=5000
